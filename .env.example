# Copy to .env (git-ignored) and fill in. Nothing here is needed for the default `docker compose up`
# (offline reproduction) or for `--profile verify` (public RPC).

# Keyed mainnet RPC + WebSocket for the live/dryrun profiles (e.g. a free Helius endpoint).
# API keys in these URLs are redacted from every log and data file.
RPC_URL=
WS_URL=

# Directory on the host holding master.json (the funded measurement wallet) and payers/ (created by
# `docker compose --profile keys run --rm keys-init`). Mounted read-only for measurements.
ITB_KEYS_DIR=

# Optional
VERIFY_RPC_URL=https://api.mainnet-beta.solana.com
VERIFY_SAMPLE=30
DRYRUN_WINDOWS=10
